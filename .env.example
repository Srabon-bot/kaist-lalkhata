GEMINI_API_KEY=your-ai-studio-key-here

# Required for accounts/sync (see PLAN.md) — a Neon Postgres connection
# string. Run `psql $DATABASE_URL -f db/schema.sql` once before the
# api/auth/* and api/sync routes will work.
DATABASE_URL=

# Required for accounts/sync — any random string, used to sign session
# cookies (HMAC-SHA256). Changing it invalidates all existing sessions.
SESSION_SECRET=

# Optional — enables the "Continue with Google" button on the welcome page.
# Create a free OAuth Client ID (Web application) in Google Cloud Console,
# add this app's origin(s) under "Authorized JavaScript origins", no client
# secret needed. Without it the button shows a "not set up yet" message.
VITE_GOOGLE_CLIENT_ID=
